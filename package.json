{
  "name": "@demacia1314/wordagent",
  "version": "2.2.0",
  "description": "Local AI editing sidebar for Microsoft Word with live document updates.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/demacia1314/WordAgent.git"
  },
  "bin": {
    "wordagent": "bin/wordagent.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "manifest.xml",
    "docs/distribution.md",
    "docs/document-tools.md",
    "npm-shrinkwrap.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --out-dir dist-server --external mammoth",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src server shared scripts tests *.json *.ts *.html README.md docs",
    "typecheck": "tsc --noEmit",
    "certs": "office-addin-dev-certs install",
    "manifest:validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml desktop --app word --dev-server-port 3001",
    "package:release": "tsx scripts/package-release.ts",
    "package:npm": "npm run build && node scripts/pack-npm.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "diff": "^8.0.0",
    "docx": "^9.5.0",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.4.0",
    "zod": "^3.24.0",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "tsx": {
      "esbuild": "^0.28.1"
    },
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/office-js": "^1.0.400",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^29.1.1",
    "office-addin-manifest": "^2.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
